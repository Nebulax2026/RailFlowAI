# Backend API used by the Next.js rewrite proxy.
RAILFLOW_API_BASE_URL=http://127.0.0.1:8000

# Optional browser-side override. Leave empty for the default same-origin /api proxy.
NEXT_PUBLIC_API_BASE_URL=

# Backend settings.
RAILFLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RAILFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
RAILFLOW_DB_PATH=backend/.railflow/railflow.sqlite3
RAILFLOW_DEMO_CONTROLS_ENABLED=true
RAILFLOW_HOSTED=false

# Optional shared PostgreSQL database. Use Supabase's session-pooler URL.
# Keep the real value only in a local .env file or the backend host's secret settings.
DATABASE_URL=
# AI Agent mode (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
